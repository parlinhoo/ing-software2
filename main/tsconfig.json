{
  "compilerOptions": {
    "jsx": "react-jsx",
    /* Base Options: */
    "esModuleInterop": true,
    "skipLibCheck": true,
    "target": "es2022",
    "resolveJsonModule": true,
    "moduleDetection": "force",
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noImplicitAny": true,
    "module": "NodeNext",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "sourceMap": true,

    "outDir": "dist",
    "rootDir": "./",

    "lib": ["es2022", "DOM"],
    "types": ["vite/client"]
  },

  "include": ["src/**/*"],
}